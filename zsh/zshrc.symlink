export GITHUB_HANDLE=amateurhuman

export SOURCE=$HOME/Source
export GITHUB_SOURCE=$SOURCE/github.com
export DOTFILES=$GITHUB_SOURCE/$GITHUB_HANDLE/dotfiles

eval "$(/opt/homebrew/bin/brew shellenv)"

# Source every config, alias, path file in dotfiles
for config_file in $DOTFILES/**/*.zsh(N); do
  [[ -r "$config_file" ]] && source "$config_file"
done
for alias_file in $DOTFILES/**/*.alias(N); do
  [[ -r "$alias_file" ]] && source "$alias_file"
done
for path_file in $DOTFILES/**/*.path(N); do
  [[ -r "$path_file" ]] && source "$path_file"
done

# Initialize mise last
eval "$(/opt/homebrew/bin/mise activate zsh)"
