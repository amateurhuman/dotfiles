#!/usr/bin/env bash
#
# Bootstrap dotfiles on a fresh macOS system
# Usage: curl https://raw.githubusercontent.com/amateurhuman/dotfiles/main/script/bootstrap | bash
#
# This script:
# 1. Installs Xcode Command Line Tools (includes git)
# 2. Clones the dotfiles repository
# 3. Sets up the symlink
# 4. Provides next steps

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[1;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NOCOLOR='\033[0m'

info() { printf "\r  [ ${BLUE}..${NOCOLOR} ] $1\n"; }
success() { printf "\r\033[2K  [ ${GREEN}OK${NOCOLOR} ] $1\n"; }
fail() { printf "\r\033[2K  [${RED}FAIL${NOCOLOR}] $1\n"; echo ''; exit 1; }
warn() { printf "\r\033[2K  [${YELLOW}WARN${NOCOLOR}] $1\n"; }

# Configuration
GITHUB_USER="amateurhuman"
REPO_NAME="dotfiles"
GITHUB_REPO="https://github.com/${GITHUB_USER}/${REPO_NAME}.git"

# Target locations
SOURCE_DIR="$HOME/Source"
GITHUB_SOURCE_DIR="$SOURCE_DIR/github.com"
TARGET_DIR="$GITHUB_SOURCE_DIR/$GITHUB_USER/$REPO_NAME"
SYMLINK_TARGET="$HOME/.dotfiles"

# Check if running on macOS
if [ "$(uname -s)" != "Darwin" ]; then
  fail "This bootstrap script is designed for macOS only"
fi

# Check if running as root
if [ "$USER" = "root" ]; then
  fail "Don't run this script as root - run as your regular user"
fi

# Check if user is in admin group
if ! groups | grep -q "\badmin\b"; then
  fail "User $USER must be in the admin group to run this script"
fi

echo ""
info "Bootstrapping @${GITHUB_USER} dotfiles on macOS..."

# Prevent system sleep during setup
caffeinate -s -w $$ &

# Install Xcode Command Line Tools
info "Checking Xcode Command Line Tools..."
if ! [ -f "/Library/Developer/CommandLineTools/usr/bin/git" ]; then
  info "Installing Xcode Command Line Tools..."
  
  # Create placeholder to trigger installation
  CLT_PLACEHOLDER="/tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress"
  sudo touch "$CLT_PLACEHOLDER"
  
  # Find and install the Command Line Tools package
  CLT_PACKAGE=$(softwareupdate -l | \
    grep -B 1 "Command Line Tools" | \
    awk -F"*" '/^ *\*/ {print $2}' | \
    sed -e 's/^ *Label: //' -e 's/^ *//' | \
    sort -V | \
    tail -n1)
  
  if [ -n "$CLT_PACKAGE" ]; then
    sudo softwareupdate -i "$CLT_PACKAGE"
  else
    # Fallback to interactive installation
    xcode-select --install
    info "Please complete the Xcode Command Line Tools installation and re-run this script"
    exit 0
  fi
  
  sudo rm -f "$CLT_PLACEHOLDER"
  success "Xcode Command Line Tools installed"
else
  success "Xcode Command Line Tools already installed"
fi

# Accept Xcode license if needed
if /usr/bin/xcrun clang 2>&1 | grep -q license; then
  info "Accepting Xcode license..."
  sudo xcodebuild -license accept
  success "Xcode license accepted"
fi

# Verify git is available
if ! command -v git &> /dev/null; then
  fail "Git is still not available after Command Line Tools installation"
fi

# Create directory structure
info "Creating directory structure..."
mkdir -p "$GITHUB_SOURCE_DIR"
success "Created $GITHUB_SOURCE_DIR"

# Check if target directory already exists
if [ -d "$TARGET_DIR" ]; then
  warn "Directory $TARGET_DIR already exists"
  info "Updating existing repository..."
  cd "$TARGET_DIR"
  git pull origin main || fail "Failed to update existing repository"
  success "Updated existing dotfiles repository"
else
  info "Cloning dotfiles repository..."
  git clone "$GITHUB_REPO" "$TARGET_DIR" || fail "Failed to clone repository"
  success "Cloned dotfiles to $TARGET_DIR"
fi

# Handle symlink
if [ -L "$SYMLINK_TARGET" ]; then
  # It's already a symlink, check if it points to the right place
  CURRENT_TARGET=$(readlink "$SYMLINK_TARGET")
  if [ "$CURRENT_TARGET" = "$TARGET_DIR" ]; then
    success "Symlink $SYMLINK_TARGET already points to correct location"
  else
    warn "Symlink $SYMLINK_TARGET points to $CURRENT_TARGET"
    info "Updating symlink to point to $TARGET_DIR"
    rm "$SYMLINK_TARGET"
    ln -s "$TARGET_DIR" "$SYMLINK_TARGET"
    success "Updated symlink"
  fi
elif [ -e "$SYMLINK_TARGET" ]; then
  # Something exists at ~/.dotfiles but it's not a symlink
  warn "File or directory exists at $SYMLINK_TARGET"
  info "Moving existing $SYMLINK_TARGET to ${SYMLINK_TARGET}.backup"
  mv "$SYMLINK_TARGET" "${SYMLINK_TARGET}.backup"
  ln -s "$TARGET_DIR" "$SYMLINK_TARGET"
  success "Created symlink (backed up existing file)"
else
  # Nothing exists, create the symlink
  info "Creating symlink $SYMLINK_TARGET -> $TARGET_DIR"
  ln -s "$TARGET_DIR" "$SYMLINK_TARGET"
  success "Created symlink"
fi

# Check for and install software updates
info "Checking for software updates..."
if softwareupdate -l 2>&1 | grep -q "No new software available"; then
  success "System is up to date"
else
  info "Installing available software updates..."
  sudo softwareupdate --install --all
  success "Software updates installed"
fi

# Install Homebrew
info "Installing Homebrew..."
if command -v brew >/dev/null 2>&1; then
  success "Homebrew already installed"
else
  # Install Homebrew
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  
  # Add Homebrew to PATH for current session
  if [[ $(uname -m) == 'arm64' ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  else
    eval "$(/usr/local/bin/brew shellenv)"
  fi
  
  success "Homebrew installed"
fi

# Update Homebrew
info "Updating Homebrew..."
brew update --quiet
success "Homebrew updated"

echo ""
success "Bootstrap complete!"
echo ""
info "Your system is now updated and ready for dotfiles installation:"
echo "  Repository: $TARGET_DIR"
echo "  Symlink:    $SYMLINK_TARGET"
echo ""
info "Next steps:"
echo "  1. Install dotfiles: ${GREEN}~/.dotfiles/script/install${NOCOLOR}"
echo "  2. Restart your terminal when done"
echo ""
info "For help, see: ${BLUE}https://github.com/${GITHUB_USER}/${REPO_NAME}${NOCOLOR}"
echo ""