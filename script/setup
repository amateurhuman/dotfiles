#!/usr/bin/env bash
#
# script/setup - Prepare a fresh macOS system for dotfiles installation
#
# This script sets up essential macOS defaults and installs core dependencies
# needed before running the full installation process.
#

set -e

# Color output
RED='\033[0;31m'
GREEN='\033[1;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NOCOLOR='\033[0m'

info() { printf "\r  [ ${BLUE}..${NOCOLOR} ] $1\n"; }
success() { printf "\r\033[2K  [ ${GREEN}OK${NOCOLOR} ] $1\n"; }
fail() { printf "\r\033[2K  [${RED}FAIL${NOCOLOR}] $1\n"; echo ''; exit 1; }
warn() { printf "\r\033[2K  [${YELLOW}WARN${NOCOLOR}] $1\n"; }

# Check if running on macOS
if [ "$(uname -s)" != "Darwin" ]; then
  fail "This setup script is designed for macOS only"
fi

# Check if running as root
if [ "$USER" = "root" ]; then
  fail "Don't run this script as root - run as your regular user"
fi

# Check if user is in admin group
if ! groups | grep -q "\badmin\b"; then
  fail "User $USER must be in the admin group to run this script"
fi

echo ""
info "Setting up macOS base system and settings..."

# Prevent system sleep during setup
caffeinate -s -w $$ &

# Install Xcode Command Line Tools
info "Checking Xcode Command Line Tools..."
if ! [ -f "/Library/Developer/CommandLineTools/usr/bin/git" ]; then
  info "Installing Xcode Command Line Tools..."
  
  # Create placeholder to trigger installation
  CLT_PLACEHOLDER="/tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress"
  sudo touch "$CLT_PLACEHOLDER"
  
  # Find and install the Command Line Tools package
  CLT_PACKAGE=$(softwareupdate -l | \
    grep -B 1 "Command Line Tools" | \
    awk -F"*" '/^ *\*/ {print $2}' | \
    sed -e 's/^ *Label: //' -e 's/^ *//' | \
    sort -V | \
    tail -n1)
  
  if [ -n "$CLT_PACKAGE" ]; then
    sudo softwareupdate -i "$CLT_PACKAGE"
  else
    # Fallback to interactive installation
    xcode-select --install
    info "Please complete the Xcode Command Line Tools installation and re-run this script"
    exit 0
  fi
  
  sudo rm -f "$CLT_PLACEHOLDER"
  success "Xcode Command Line Tools installed"
else
  success "Xcode Command Line Tools already installed"
fi

# Accept Xcode license if needed
if /usr/bin/xcrun clang 2>&1 | grep -q license; then
  info "Accepting Xcode license..."
  sudo xcodebuild -license accept
  success "Xcode license accepted"
fi

# Configure basic security settings
info "Configuring security settings..."
sudo defaults write com.apple.screensaver askForPassword -int 1
sudo defaults write com.apple.screensaver askForPasswordDelay -int 0
sudo defaults write /Library/Preferences/com.apple.alf globalstate -int 1
sudo launchctl load /System/Library/LaunchDaemons/com.apple.alf.agent.plist 2>/dev/null || true
success "Security settings configured"

# Check FileVault status
info "Checking FileVault encryption..."
if fdesetup status | grep -q "FileVault is On"; then
  success "FileVault already enabled"
elif fdesetup status | grep -q "FileVault is Off, but will be enabled after the next restart"; then
  success "FileVault will be enabled after restart"
else
  warn "FileVault is not enabled. Consider running: sudo fdesetup enable -user \"$USER\""
fi

# Check for and install software updates
info "Checking for software updates..."
if softwareupdate -l 2>&1 | grep -q "No new software available"; then
  success "System is up to date"
else
  warn "Software updates available. Consider running: sudo softwareupdate --install --all"
fi

# Install Homebrew
info "Installing Homebrew..."
if command -v brew >/dev/null 2>&1; then
  success "Homebrew already installed"
else
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  
  # Add Homebrew to PATH for current session
  if [[ $(uname -m) == 'arm64' ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  else
    eval "$(/usr/local/bin/brew shellenv)"
  fi
  
  success "Homebrew installed"
fi

# Update Homebrew
info "Updating Homebrew..."
brew update --quiet
success "Homebrew updated"

echo ""
success "System setup complete"
echo ""
info "Next steps:"
echo "  1. Install dotfiles: ~/.dotfiles/script/install"
echo ""