#!/usr/bin/env bash
#
# script/install - Install and configure all dotfiles and dependencies
#
# This script combines the dotfiles symlinking and dependency installation
# into a single comprehensive installation process.
#

cd "$(dirname "$0")/.."
DOTFILES_ROOT=$(pwd -P)

set -e

# Check if running as root
if [ "$USER" = "root" ]; then
  echo "Don't run this script as root - run as your regular user"
  exit 1
fi

# Color output
RED='\033[0;31m'
GREEN='\033[1;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NOCOLOR='\033[0m'

info() { printf "\r  [ ${BLUE}..${NOCOLOR} ] $1\n"; }
user() { printf "\r  [ ${YELLOW}??${NOCOLOR} ] $1\n"; }
success() { printf "\r\033[2K  [ ${GREEN}OK${NOCOLOR} ] $1\n"; }
fail() { printf "\r\033[2K  [${RED}FAIL${NOCOLOR}] $1\n"; echo ''; exit 1; }

link_file () {
  local src=$1 dst=$2

  local overwrite= backup= skip=
  local action=

  if [ -f "$dst" -o -d "$dst" -o -L "$dst" ]
  then

    if [ "$overwrite_all" == "false" ] && [ "$backup_all" == "false" ] && [ "$skip_all" == "false" ]
    then

      local currentSrc="$(readlink $dst)"

      if [ "$currentSrc" == "$src" ]
      then

        skip=true;

      else

        user "File already exists: $dst ($(basename "$src")), what do you want to do?\n\
        [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
        read -n 1 action

        case "$action" in
          o )
            overwrite=true;;
          O )
            overwrite_all=true;;
          b )
            backup=true;;
          B )
            backup_all=true;;
          s )
            skip=true;;
          S )
            skip_all=true;;
          * )
            ;;
        esac

      fi

    fi

    overwrite=${overwrite:-$overwrite_all}
    backup=${backup:-$backup_all}
    skip=${skip:-$skip_all}

    if [ "$overwrite" == "true" ]
    then
      rm -rf "$dst"
      success "removed $dst"
    fi

    if [ "$backup" == "true" ]
    then
      mv "$dst" "${dst}.backup"
      success "moved $dst to ${dst}.backup"
    fi

    if [ "$skip" == "true" ]
    then
      success "skipped $src"
    fi
  fi

  if [ "$skip" != "true" ]  # "false" or empty
  then
    ln -s "$1" "$2"
    success "linked $1 to $2"
  fi
}

install_dotfiles () {
  info 'installing dotfiles'

  local overwrite_all=false backup_all=false skip_all=false

  for src in $(find -H "$DOTFILES_ROOT" -maxdepth 2 -name '*.symlink' -not -path '*.git*')
  do
    dst="$HOME/.$(basename "${src%.*}")"
    link_file "$src" "$dst"
  done
}

install_configs () {
  info 'installing XDG config directory'

  local overwrite_all=false backup_all=false skip_all=false

  # Check if config directory exists
  if [ -d "$DOTFILES_ROOT/config" ]; then
    dst="$HOME/.config"
    link_file "$DOTFILES_ROOT/config" "$dst"
  fi
}

install_dotfiles
install_configs

# Install packages from Brewfile
info "installing packages from Brewfile"

# Find and setup Homebrew
BREW_PATH=""
if command -v brew >/dev/null 2>&1; then
  BREW_PATH="brew"
elif [ -f "/opt/homebrew/bin/brew" ]; then
  # Apple Silicon Mac
  eval "$(/opt/homebrew/bin/brew shellenv)"
  BREW_PATH="/opt/homebrew/bin/brew"
elif [ -f "/usr/local/bin/brew" ]; then
  # Intel Mac
  eval "$(/usr/local/bin/brew shellenv)"
  BREW_PATH="/usr/local/bin/brew"
else
  fail "Homebrew not found. Please run script/bootstrap first."
fi

if [ -f "$HOME/.Brewfile" ]; then
  $BREW_PATH bundle check --global || $BREW_PATH bundle --global
  success "Brewfile packages installed"
else
  fail "No Brewfile found at $HOME/.Brewfile"
fi

# find the installers and run them iteratively
info "installing dependencies"
if [ "$(uname -s)" == "Darwin" ]
then
  find . -name install.sh | while read installer ; do 
    info "running ${installer}"
    chmod +x "${installer}"
    sh -c "${installer}"
  done
fi

echo ''
success "All installed!"