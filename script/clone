#!/usr/bin/env bash
#
# Clone dotfiles to proper location and set up symlink
# Usage: curl https://raw.githubusercontent.com/amateurhuman/dotfiles/main/script/clone | bash
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[1;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NOCOLOR='\033[0m'

info() { printf "\r  [ ${BLUE}..${NOCOLOR} ] $1\n"; }
success() { printf "\r\033[2K  [ ${GREEN}OK${NOCOLOR} ] $1\n"; }
fail() { printf "\r\033[2K  [${RED}FAIL${NOCOLOR}] $1\n"; echo ''; exit 1; }
warn() { printf "\r\033[2K  [${YELLOW}WARN${NOCOLOR}] $1\n"; }

# Configuration
GITHUB_USER="amateurhuman"
REPO_NAME="dotfiles"
GITHUB_REPO="https://github.com/${GITHUB_USER}/${REPO_NAME}.git"

# Target locations
SOURCE_DIR="$HOME/Source"
GITHUB_SOURCE_DIR="$SOURCE_DIR/github.com"
TARGET_DIR="$GITHUB_SOURCE_DIR/$GITHUB_USER/$REPO_NAME"
SYMLINK_TARGET="$HOME/.dotfiles"

echo ""
info "Setting up @${GITHUB_USER} dotfiles..."

# Check prerequisites
if ! command -v git &> /dev/null; then
  fail "Git is required but not installed. Please install Git first."
fi

# Create directory structure
info "Creating directory structure..."
mkdir -p "$GITHUB_SOURCE_DIR"
success "Created $GITHUB_SOURCE_DIR"

# Check if target directory already exists
if [ -d "$TARGET_DIR" ]; then
  warn "Directory $TARGET_DIR already exists"
  info "Updating existing repository..."
  cd "$TARGET_DIR"
  git pull origin main || fail "Failed to update existing repository"
  success "Updated existing dotfiles repository"
else
  info "Cloning dotfiles repository..."
  git clone "$GITHUB_REPO" "$TARGET_DIR" || fail "Failed to clone repository"
  success "Cloned dotfiles to $TARGET_DIR"
fi

# Handle symlink
if [ -L "$SYMLINK_TARGET" ]; then
  # It's already a symlink, check if it points to the right place
  CURRENT_TARGET=$(readlink "$SYMLINK_TARGET")
  if [ "$CURRENT_TARGET" = "$TARGET_DIR" ]; then
    success "Symlink $SYMLINK_TARGET already points to correct location"
  else
    warn "Symlink $SYMLINK_TARGET points to $CURRENT_TARGET"
    info "Updating symlink to point to $TARGET_DIR"
    rm "$SYMLINK_TARGET"
    ln -s "$TARGET_DIR" "$SYMLINK_TARGET"
    success "Updated symlink"
  fi
elif [ -e "$SYMLINK_TARGET" ]; then
  # Something exists at ~/.dotfiles but it's not a symlink
  warn "File or directory exists at $SYMLINK_TARGET"
  info "Moving existing $SYMLINK_TARGET to ${SYMLINK_TARGET}.backup"
  mv "$SYMLINK_TARGET" "${SYMLINK_TARGET}.backup"
  ln -s "$TARGET_DIR" "$SYMLINK_TARGET"
  success "Created symlink (backed up existing file)"
else
  # Nothing exists, create the symlink
  info "Creating symlink $SYMLINK_TARGET -> $TARGET_DIR"
  ln -s "$TARGET_DIR" "$SYMLINK_TARGET"
  success "Created symlink"
fi

echo ""
success "Dotfiles setup complete!"
echo ""
info "Your dotfiles are now located at:"
echo "  Repository: $TARGET_DIR"
echo "  Symlink:    $SYMLINK_TARGET"
echo ""
info "Next steps:"
echo "  1. Run: ${GREEN}~/.dotfiles/script/bootstrap${NOCOLOR}"
echo "  2. Follow the prompts to complete installation"
echo "  3. Restart your terminal when done"
echo ""
info "For help, see: ${BLUE}https://github.com/${GITHUB_USER}/${REPO_NAME}${NOCOLOR}"
echo ""