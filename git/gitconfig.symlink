[user]
  name = Chris Kelly
	email = chris@augmentcode.com
  signingkey = DEFINEME
[core]
  pager = delta
[include]
  path = ~/Source/github.com/dandavison/delta/themes.gitconfig
[interactive]
    diffFilter = delta --color-only
[github]
  user = amateurhuman
[push]
  default = tracking
[gpg]
  program = gpg
[credential]
  helper = osxkeychain
[commit]
  gpgsign = false
[merge]
    conflictstyle = zdiff3
[rebase]
  autosquash = true
[color]
  ui = auto
[color "status"]
  added = green
  changed = yellow
  untracked = red
[alias]
  aa = add --all
  cl  = "!tidyclone() { url=$1; path=${url#*://}; dir=${path%.git}; git clone $url $SOURCE/$dir ${@:2}; }; tidyclone"
  co  = checkout
  ds  = diff --staged
  lol = log --pretty=format:"%C(yellow)%h\\ %C(blue)%ad%C(red)%d\\ %C(reset)%s%C(green)\\ [%an]" --decorate --date=short
  lls = log --pretty=format:"%C(yellow)%h\\ %C(green)%<(20,trunc)%cn\\ %C(blue)%ad%C(red)%d\\ %C(reset)%s" --date=short --decorate
  st  = status -sb
  undo = reset --soft HEAD^
  absorb = "!sh -c 'CURRENT=$(git rev-parse HEAD); REMOTE=$(git rev-parse @{u} 2>/dev/null || echo \"\"); if [ \"$REMOTE\" = \"$CURRENT\" ]; then read -p \"This commit exists on remote and will require force push. Continue? [y/N] \" confirm; if [ \"$confirm\" = \"y\" ] || [ \"$confirm\" = \"Y\" ]; then git commit --amend --no-edit; else echo \"Aborting amend\"; exit 1; fi; else git commit --amend --no-edit; fi'"
  squash = "!squash() { \
        first=$(git rev-list --reverse $(git merge-base origin/main HEAD)..HEAD | head -n1); \
        git rebase -i --autosquash ${first}^; \
    }; squash"
[init]
  defaultBranch = main
[delta]
  dark = true
  features = arctic-fox
  navigate = true
  line-numbers = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
