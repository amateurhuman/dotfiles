[user]
  name = Chris Kelly
	email = chris@amateurhuman.com
  signingkey = DEFINEME
[core]
  pager = delta
[include]
  path = ~/Source/github.com/dandavison/delta/themes.gitconfig
[interactive]
    diffFilter = delta --color-only
[github]
  user = amateurhuman
[push]
  default = tracking
[gpg]
  program = gpg
[credential]
  helper = osxkeychain
[commit]
  gpgsign = false
[merge]
  conflictstyle = zdiff3
[rebase]
  autosquash = true
[color]
  ui = auto
[color "status"]
  added = green
  changed = yellow
  untracked = red
[alias]
  aa = add --all
  co  = checkout
  st  = status -sb
  ds  = diff --staged
  lol = log --pretty=format:"%C(yellow)%h\\ %C(blue)%ad%C(red)%d\\ %C(reset)%s%C(green)\\ [%an]" --decorate --date=short
  lls = log --pretty=format:"%C(yellow)%h\\ %C(green)%<(20,trunc)%cn\\ %C(blue)%ad%C(red)%d\\ %C(reset)%s" --date=short --decorate
  amend = commit --amend --no-edit
  uncommit = reset --soft HEAD^
  unstage = reset HEAD
[init]
  defaultBranch = main
[delta]
  dark = true
  features = arctic-fox
  navigate = true
  line-numbers = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
